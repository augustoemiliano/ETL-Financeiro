# -----------------------------------------------------------------------------
# Copie para `.env`. Nunca commite segredos reais em repositório público.
# Dentro do Docker Compose o host Postgres é `postgres:5432`; na máquina host
# expomos `localhost:5435` (vide docker-compose.yml).
# -----------------------------------------------------------------------------

# Obrigatório — SQLAlchemy + Alembic (PostgreSQL é o destino oficial)
DATABASE_URL=postgresql+psycopg2://etl_user:etl_pass@127.0.0.1:5435/etl_db
# Alternativa sem Docker/Postgres, só para desenvolvimento local:
# DATABASE_URL=sqlite:///etl_local.db

# Usadas pelo docker-compose.yml (credenciais do container Postgres)
POSTGRES_DB=etl_db
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_pass

ENVIRONMENT=development
DEBUG=false

LOG_LEVEL=INFO
LOG_DIR=logs
REPORTS_DIR=reports
# Janela dos relatórios em dias (vazio = histórico completo)
REPORT_HISTORY_DAYS=

# Diretórios lidos pelo pipeline: todos os *.csv e *.xlsx encontrados
CSV_INPUT_DIR=data/samples
XLSX_INPUT_DIR=data/samples

# Fonte HTTP (API pública Frankfurter, sem chave)
FX_ENABLED=true
FX_API_BASE_URL=https://api.frankfurter.app
FX_BASE_CURRENCY=USD
FX_TARGET_CURRENCIES=BRL,EUR,GBP
FX_CONNECT_TIMEOUT=5
FX_READ_TIMEOUT=30

# Retry exponencial das chamadas HTTP (tenacity)
HTTP_RETRY_ATTEMPTS=4
HTTP_RETRY_MIN_WAIT=2
HTTP_RETRY_MAX_WAIT=20

# Apenas para `python main.py scheduler`; se false, o comando sai sem loop
SCHEDULER_ENABLED=true
SCHEDULER_RUN_TIME=02:00
SCHEDULER_RETRY_ATTEMPTS=4

# 127.0.0.1 = só a máquina local; o container usa 0.0.0.0 (docker/backend-entry.sh)
API_HOST=127.0.0.1
API_PORT=8000
